generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model usuarios {
  id_usuario             Int                      @id @default(autoincrement())
  nombre_usuario         String                   @db.VarChar(100)
  correo                 String                   @unique @db.VarChar(100)
  password               String                   @db.VarChar(255)
  rol                    String?                  @db.VarChar(20)
  fecha_creacion         DateTime?                @default(now()) @db.Timestamp(6)
  movimientos_inventario movimientos_inventario[]
  ventas                 ventas[]
}

model categorias {
  id_categoria     Int         @id @default(autoincrement())
  nombre_categoria String      @db.VarChar(100)
  descripcion      String?
  productos        productos[]
}

model detalle_venta {
  id_detalle      Int       @id @default(autoincrement())
  id_venta        Int
  id_producto     Int
  cantidad        Decimal   @db.Decimal(10, 3) // CAMBIO: Permite fraccionamiento (ej: 0.750 kg)
  precio_unitario Decimal   @db.Decimal(10, 2)
  subtotal        Decimal?  @db.Decimal(10, 2)
  productos       productos @relation(fields: [id_producto], references: [id_producto], onDelete: SetNull, onUpdate: NoAction)
  ventas          ventas    @relation(fields: [id_venta], references: [id_venta], onDelete: Cascade, onUpdate: NoAction)

  @@index([id_venta], map: "idx_detalle_venta_venta")
}

model movimientos_inventario {
  id_movimiento    Int          @id @default(autoincrement())
  id_producto      Int?
  tipo_movimiento  String?      @db.VarChar(20)
  cantidad         Decimal      @db.Decimal(10, 3) // CAMBIO: Registra entradas/salidas en decimales
  fecha_movimiento DateTime?    @default(now()) @db.Timestamp(6)
  motivo           String?
  id_usuario       Int?
  id_proveedor     Int?
  productos        productos?   @relation(fields: [id_producto], references: [id_producto], onUpdate: NoAction)
  proveedores      proveedores? @relation(fields: [id_proveedor], references: [id_proveedor], onUpdate: NoAction)
  usuarios         usuarios?    @relation(fields: [id_usuario], references: [id_usuario], onUpdate: NoAction)

  @@index([id_producto], map: "idx_movimientos_producto")
  @@index([id_proveedor], map: "idx_movimientos_proveedor")
  @@index([id_usuario], map: "idx_movimientos_usuario")
}

model productos {
  id_producto            Int                      @id @default(autoincrement())
  nombre_producto        String                   @db.VarChar(150)
  id_categoria           Int?
  codigo_barra           String?                  @unique @db.VarChar(50)
  precio_compra          Decimal                  @db.Decimal(10, 2)
  precio_venta           Decimal                  @db.Decimal(10, 2)
  stock_actual           Decimal?                 @default(0) @db.Decimal(10, 3) // CAMBIO: Stock soporta decimales
  stock_minimo           Decimal?                 @default(0) @db.Decimal(10, 3) // CAMBIO: Umbral ROP soporta decimales
  unidad_medida          String?                  @db.VarChar(50)
  fecha_creacion         DateTime?                @default(now()) @db.Timestamp(6)
  estado                 String?                  @default("activo") @db.VarChar(20)
  detalle_venta          detalle_venta[]
  movimientos_inventario movimientos_inventario[]
  categorias             categorias?              @relation(fields: [id_categoria], references: [id_categoria], onUpdate: NoAction)

  @@index([id_categoria], map: "idx_producto_categoria")
}

model proveedores {
  id_proveedor           Int                      @id @default(autoincrement())
  nombre                 String                   @db.VarChar(150)
  contacto               String?                  @db.VarChar(150)
  telefono               String?                  @db.VarChar(30)
  correo                 String?                  @db.VarChar(100)
  direccion              String?
  movimientos_inventario movimientos_inventario[]
}

model ventas {
  id_venta      Int             @id @default(autoincrement())
  fecha_venta   DateTime?       @default(now()) @db.Timestamp(6)
  id_usuario    Int?
  total         Decimal         @db.Decimal(10, 2)
  metodo_pago   String?         @db.VarChar(50)
  estado        String?         @default("completada") @db.VarChar(20)
  detalle_venta detalle_venta[]
  usuarios      usuarios?       @relation(fields: [id_usuario], references: [id_usuario], onUpdate: NoAction)
}
